PORT=4000
DB_PATH=./data/crabsem.sqlite
NODE_ENV=development

# Comma-separated browser origins allowed to call this API, e.g.
# https://crabsem.com,https://www.crabsem.com
# Leave empty in local development (falls back to permissive CORS).
# Required for a production deployment - see server/INTELLIGENCE_ENGINE.md
# and the production-readiness audit.
CORS_ALLOWED_ORIGINS=

# GMGN OpenAPI (https://openapi.gmgn.ai)
# Populated automatically by `npm run gmgn:generate-keys`, except
# GMGN_API_KEY which you obtain manually by registering the generated
# public key at https://gmgn.ai/ai.
GMGN_HOST=https://openapi.gmgn.ai
GMGN_API_KEY=
GMGN_PRIVATE_KEY=

# Admin Panel (/admin) - single shared password, sent by the browser
# as the X-Admin-Key header on every /api/v1/admin/* call. Leaving
# this unset disables the admin API entirely (fails closed, not open).
ADMIN_PASSWORD=

# Execution Layer foundation (server/src/services/execution/) - a real,
# non-rate-limited Solana RPC endpoint (e.g. from Helius/QuickNode/your
# own node). Leaving this unset disables the execution layer entirely
# (fails closed, not open) - it does NOT fall back to a public cluster.
SOLANA_RPC_URL=
SOLANA_COMMITMENT=confirmed
EXECUTION_CONFIRMATION_TIMEOUT_MS=60000
EXECUTION_CONFIRMATION_POLL_INTERVAL_MS=2000

# Founder Mode (Sprint 2) - the ONLY wallet allowed to trade while this
# remains single-user. Leave unset and nothing can trade (fails closed).
# Set to the founder's real Trading Wallet public key once it exists.
FOUNDER_WALLET_PUBLIC_KEY=
